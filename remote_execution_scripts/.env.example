# Copy to .env and edit. .env is gitignored.
# Loaded by lib/common.sh::bootstrap before config.sh, so any var set here
# becomes the default for every script in this folder. Anything already set
# in your shell still wins (so `SSH_KEY=... ./02_run.sh foo` overrides).

# Required: path to the SSH private key for the VM.
SSH_KEY="$HOME/.ssh/vm_key"

# Optional overrides — uncomment to point at a different host or layout.
# VM_USER=vm03
# VM_HOST=143.107.165.250
# VM_PORT=5022
# REMOTE_WORKDIR=/media/vm03/ssd1T/andrew/dynamic/dynamic-lmms-eval
# REMOTE_DATASET_DIR=/media/vm03/ssd1T/andrew/dynamic/dynamic-dataset
# REMOTE_HF_HOME=/media/vm03/ssd1T/andrew/hf_cache
# REMOTE_UV_CACHE_DIR=/media/vm03/ssd1T/andrew/uv_cache
